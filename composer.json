{
  "name": "pharaonic/laravel-api-idempotency",
  "description": "Opt-in HTTP idempotency for Laravel routes: Route::post(...)->idempotent() with atomic database or Redis reservation, request fingerprinting, safe response replay and fail-closed recovery.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "api",
    "idempotency",
    "idempotency-key",
    "idempotent",
    "middleware",
    "replay",
    "redis",
    "concurrency",
    "rest"
  ],
  "homepage": "https://pharaonic.dev/packages/laravel/api-idempotency",
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/laravel/api-idempotency",
    "issues": "https://github.com/Pharaonic/laravel-api-idempotency/issues",
    "source": "https://github.com/Pharaonic/laravel-api-idempotency"
  },
  "require": {
    "php": ">=8.0 <8.1",
    "illuminate/console": "^7.30",
    "illuminate/contracts": "^7.30",
    "illuminate/database": "^7.30",
    "illuminate/http": "^7.30",
    "illuminate/redis": "^7.30",
    "illuminate/routing": "^7.30",
    "illuminate/support": "^7.30",
    "pharaonic/php-fingerprint": "~8.0.3"
  },
  "require-dev": {
    "laravel/pint": "^1.5",
    "orchestra/testbench": "^5.20",
    "pestphp/pest": "^1.23",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6.33",
    "predis/predis": "^1.1.10"
  },
  "suggest": {
    "ext-redis": "For the redis store with the phpredis client (predis/predis works too)."
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Laravel\\ApiIdempotency\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Laravel\\ApiIdempotency\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Laravel\\ApiIdempotency\\ApiIdempotencyServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false,
        "ignore": {
          "laravel/framework": "No fixed release within Laravel 7; the application chooses the framework release.",
          "league/commonmark": "No fixed release within Laravel 7; the application chooses the framework release.",
          "league/flysystem": "No fixed release within Laravel 7; the application chooses the framework release."
        }
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
