{
  "name": "pharaonic/laravel-api-idempotency",
  "description": "Opt-in HTTP idempotency for Laravel routes: Route::post(...)->idempotent() with atomic database or Redis reservation, request fingerprinting, safe response replay and fail-closed recovery.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "api",
    "idempotency",
    "idempotency-key",
    "idempotent",
    "middleware",
    "replay",
    "redis",
    "concurrency",
    "rest"
  ],
  "homepage": "https://pharaonic.dev/packages/laravel/api-idempotency",
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/laravel/api-idempotency",
    "issues": "https://github.com/Pharaonic/laravel-api-idempotency/issues",
    "source": "https://github.com/Pharaonic/laravel-api-idempotency"
  },
  "require": {
    "php": ">=8.2 <8.6",
    "illuminate/console": "^12.0",
    "illuminate/container": "^12.0",
    "illuminate/contracts": "^12.0",
    "illuminate/database": "^12.0",
    "illuminate/http": "^12.0",
    "illuminate/redis": "^12.0",
    "illuminate/routing": "^12.0",
    "illuminate/support": "^12.0",
    "pharaonic/php-fingerprint": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^10.0",
    "pestphp/pest": "^3.8 || ^4.0",
    "phpstan/phpstan": "^2.1.33",
    "phpunit/phpunit": "^11.5.50 || ^12.5.8",
    "predis/predis": "^1.1.10"
  },
  "suggest": {
    "ext-redis": "For the redis store with the phpredis client (predis/predis works too)."
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Laravel\\ApiIdempotency\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Laravel\\ApiIdempotency\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Laravel\\ApiIdempotency\\ApiIdempotencyServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
